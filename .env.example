# Copy to .env and adjust for your MySQL (e.g. Laragon defaults).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

DB_NAME=cpd

# Node listen port (Plesk often sets PORT; API_PORT is the fallback).
PORT=3001
API_PORT=3001
HOST=0.0.0.0

# Local dev with npm run dev:full — API only; UI is http://localhost:8080
SERVE_STATIC=0
TRUST_PROXY=0

# Production example (cpd.rcmp.edu.my):
# SERVE_STATIC=1
# TRUST_PROXY=1
# SESSION_SECURE=1
# APP_URL=https://cpd.rcmp.edu.my
# AZURE_REDIRECT_URI=https://cpd.rcmp.edu.my/api/auth/microsoft/callback

# Session (required for Microsoft SSO) — use a long random string in production
SESSION_SECRET=0775c78e6e559377716a6af4b7444f73f9d39083e7e720e2f4a70bd4e324e1061f2ac2d4508f127d3101bad87435756a

# Public URL of the app (used after Microsoft sign-in redirect)
APP_URL=http://localhost:8080

# Microsoft Entra ID (Azure AD) — from App registration
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Must match a Redirect URI in Azure (local dev via Vite proxy):
AZURE_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback

# OAuth scopes requested at sign-in (must include User.Read for Graph profile)
AZURE_OAUTH_SCOPES=openid profile email offline_access User.Read

# Microsoft Graph API — profile fetch for Settings page
AZURE_GRAPH_API_URL=https://graph.microsoft.com/v1.0
AZURE_GRAPH_ME_PATH=/me
AZURE_GRAPH_ME_SELECT=id,displayName,mail,userPrincipalName,jobTitle,officeLocation
