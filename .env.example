# Copy to .env and adjust for your MySQL (e.g. Laragon defaults).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

DB_NAME=cpd

# Node listen port (Plesk often sets PORT; API_PORT is the fallback).
PORT=3001
API_PORT=3001
HOST=0.0.0.0

# Behind reverse proxy (Plesk/nginx). Set to 0 only if rate limiting errors occur.
# TRUST_PROXY=1
# RATE_LIMIT_VALIDATE_XFF=0
